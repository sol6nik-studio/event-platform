{
  "name": "@arena-grid/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.seed.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0",
    "argon2": "0.45.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "prisma": "7.10.0",
    "tsx": "4.20.6"
  }
}
