generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  PLAYER
  TEAM_CAPTAIN
  ORGANIZER
  MODERATOR
  SPECTATOR
  PLATFORM_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

enum OAuthProvider {
  DISCORD
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  ORGANIZER
  MEMBER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

enum GameProvider {
  RIOT
  STEAM_DOTA
  BRAWL_STARS
  CLASH_ROYALE
  MANUAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REVOKED
}

enum TeamMemberRole {
  CAPTAIN
  PLAYER
  SUBSTITUTE
  MANAGER
}

enum TeamMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
  LADDER
  GROUP_STAGE_PLAYOFFS
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHECK_IN
  SEEDING
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum TournamentStageType {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
  LADDER
  GROUP_STAGE
  PLAYOFFS
}

enum RegistrationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
  CHECKED_IN
  WITHDRAWN
  DISQUALIFIED
}

enum CheckInStatus {
  CONFIRMED
  EXPIRED
  REVOKED
}

enum SeedSource {
  MANUAL
  RANDOM
  RANKING
}

enum BracketSide {
  SINGLE
  UPPER
  LOWER
  GRAND_FINAL
  ROUND_ROBIN
}

enum MatchStatus {
  SCHEDULED
  READY
  LIVE
  RESULT_PENDING
  DISPUTED
  COMPLETED
  WALKOVER
  CANCELLED
}

enum MatchParticipantSource {
  SEED
  WINNER
  LOSER
}

enum ResultSource {
  GAME_API
  TEAM_SUBMISSION
  MODERATOR
}

enum ResultSubmissionStatus {
  SUBMITTED
  CONFIRMED
  REJECTED
  SUPERSEDED
}

enum EvidenceKind {
  SCREENSHOT
  REPLAY
  LOG
  OTHER
}

enum EvidenceScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum MessageVisibility {
  PARTICIPANTS
  STAFF_ONLY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum PrizeKind {
  MOCK_CASH
  ITEM
  TITLE
  OTHER
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum ProviderSyncStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                        String                       @id @default(uuid()) @db.Uuid
  email                     String
  username                  String
  passwordHash              String?
  status                    UserStatus                   @default(PENDING_VERIFICATION)
  emailVerifiedAt           DateTime?                    @db.Timestamptz(3)
  locale                    String                       @default("ru")
  timezone                  String                       @default("Europe/Moscow")
  version                   Int                          @default(1)
  createdAt                 DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                     @updatedAt @db.Timestamptz(3)
  deletedAt                 DateTime?                    @db.Timestamptz(3)
  roles                     UserRole[]
  sessions                  Session[]
  oauthIdentities           OAuthIdentity[]
  emailVerificationTokens   EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  ownedOrganizations        Organization[]               @relation("OrganizationOwner")
  organizationMemberships   OrganizationMember[]         @relation("OrganizationMemberUser")
  organizationInvitesSent   OrganizationMember[]         @relation("OrganizationMemberInviter")
  gameAccounts              GameAccount[]
  teamsCreated              Team[]                       @relation("TeamCreator")
  teamMemberships           TeamMember[]
  teamInvitationsReceived   TeamInvitation[]             @relation("TeamInvitationInvitee")
  teamInvitationsSent       TeamInvitation[]             @relation("TeamInvitationSender")
  tournamentsCreated        Tournament[]                 @relation("TournamentCreator")
  moderatorAssignments      TournamentModerator[]        @relation("TournamentModeratorUser")
  moderatorAssignmentsMade  TournamentModerator[]        @relation("TournamentModeratorAssigner")
  registrationsSubmitted    Registration[]               @relation("RegistrationSubmitter")
  registrationsReviewed     Registration[]               @relation("RegistrationReviewer")
  rosterSnapshotMemberships RosterSnapshotMember[]
  checkIns                  CheckIn[]                    @relation("CheckInUser")
  resultSubmissions         ResultSubmission[]           @relation("ResultSubmitter")
  resultConfirmations       ResultSubmission[]           @relation("ResultConfirmer")
  evidenceUploads           Evidence[]
  disputesOpened            Dispute[]                    @relation("DisputeOpener")
  disputesAssigned          Dispute[]                    @relation("DisputeModerator")
  disputesResolved          Dispute[]                    @relation("DisputeResolver")
  disputeMessages           DisputeMessage[]
  notifications             Notification[]
  announcements             Announcement[]
  auditEvents               AuditEvent[]                 @relation("AuditActor")
  idempotencyRecords        IdempotencyRecord[]

  @@unique([email], map: "User_email_active_key", where: { deletedAt: null })
  @@unique([username], map: "User_username_active_key", where: { deletedAt: null })
  @@index([status, createdAt])
}

model UserRole {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  role      PlatformRole
  expiresAt DateTime?    @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, expiresAt])
}

model OAuthIdentity {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @db.Uuid
  provider             OAuthProvider
  providerUserId       String
  providerUsername     String?
  encryptedAccessToken String?
  encryptedRefreshToken String?
  tokenExpiresAt       DateTime?     @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  familyId      String         @unique @default(uuid()) @db.Uuid
  ipHash        String?
  userAgent     String?
  lastSeenAt    DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  revokeReason  String?
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  sessionId    String        @db.Uuid
  tokenHash    String        @unique
  replacedById String?       @unique @db.Uuid
  expiresAt    DateTime      @db.Timestamptz(3)
  usedAt       DateTime?     @db.Timestamptz(3)
  revokedAt    DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id          String               @id @default(uuid()) @db.Uuid
  ownerUserId String               @db.Uuid
  slug        String
  name        String
  description String?
  logoUrl     String?
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?            @db.Timestamptz(3)
  owner       User                 @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members     OrganizationMember[]
  teams       Team[]
  tournaments Tournament[]
  auditEvents AuditEvent[]

  @@unique([slug], map: "Organization_slug_active_key", where: { deletedAt: null })
  @@index([ownerUserId, deletedAt])
}

model OrganizationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  userId         String                 @db.Uuid
  invitedById    String?                @db.Uuid
  role           OrganizationMemberRole
  status         MembershipStatus       @default(ACTIVE)
  joinedAt       DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation("OrganizationMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User?                  @relation("OrganizationMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Game {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  name               String
  provider           GameProvider
  supportedPlatforms String[]      @default([])
  active             Boolean       @default(true)
  metadata           Json          @default("{}")
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  gameAccounts       GameAccount[]
  tournaments        Tournament[]

  @@index([active, name])
}

model GameAccount {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  gameId             String             @db.Uuid
  providerAccountId  String
  displayName        String
  region             String?
  platform           String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationData   Json?              @db.JsonB
  verifiedAt         DateTime?           @db.Timestamptz(3)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime?           @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  game               Game                @relation(fields: [gameId], references: [id], onDelete: Restrict)
  rosterMembers      RosterSnapshotMember[]

  @@unique([gameId, providerAccountId])
  @@index([userId, gameId, verificationStatus])
}

model Team {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  createdById    String        @db.Uuid
  slug           String
  name           String
  tag            String?
  logoUrl        String?
  description    String?
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy      User          @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members        TeamMember[]
  invitations    TeamInvitation[]
  registrations  Registration[]

  @@unique([slug], map: "Team_slug_active_key", where: { deletedAt: null })
  @@index([organizationId, deletedAt])
  @@index([createdById])
}

model TeamMember {
  id        String           @id @default(uuid()) @db.Uuid
  teamId    String           @db.Uuid
  userId    String           @db.Uuid
  role      TeamMemberRole
  status    TeamMemberStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now()) @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId], map: "TeamMember_one_active_captain_key", where: raw("\"role\" = 'CAPTAIN' AND \"status\" = 'ACTIVE'"))
  @@index([userId, status])
}

model TeamInvitation {
  id            String           @id @default(uuid()) @db.Uuid
  teamId        String           @db.Uuid
  inviteeUserId String           @db.Uuid
  invitedById   String           @db.Uuid
  tokenHash     String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime         @db.Timestamptz(3)
  respondedAt   DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  team          Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitee       User             @relation("TeamInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)
  invitedBy     User             @relation("TeamInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([teamId, inviteeUserId], map: "TeamInvitation_one_pending_key", where: raw("\"status\" = 'PENDING'"))
  @@index([inviteeUserId, status, expiresAt])
}

model Tournament {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @db.Uuid
  gameId               String                @db.Uuid
  createdById          String                @db.Uuid
  slug                 String
  name                 String
  description          String?
  status               TournamentStatus      @default(DRAFT)
  tournamentFormat     TournamentFormat
  region               String
  platform             String
  teamSize             Int
  substitutesLimit     Int                   @default(0)
  minRosterSize        Int
  maxRosterSize        Int
  bestOf               Int                   @default(1)
  participantLimit     Int
  registrationStartAt  DateTime?             @db.Timestamptz(3)
  registrationEndAt    DateTime?             @db.Timestamptz(3)
  checkInStartAt       DateTime?             @db.Timestamptz(3)
  checkInEndAt         DateTime?             @db.Timestamptz(3)
  rosterLockAt         DateTime?             @db.Timestamptz(3)
  tournamentStartAt    DateTime?             @db.Timestamptz(3)
  completedAt          DateTime?             @db.Timestamptz(3)
  cancelledAt          DateTime?             @db.Timestamptz(3)
  eligibilityRules     Json                  @default("{}") @db.JsonB
  settings             Json                  @default("{}") @db.JsonB
  streamUrl            String?
  publishedRuleRevision Int                  @default(0)
  bracketVersion       Int                   @default(0)
  scheduleVersion      Int                   @default(1)
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?             @db.Timestamptz(3)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  game                 Game                  @relation(fields: [gameId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  moderators           TournamentModerator[]
  stages               TournamentStage[]
  rules                TournamentRule[]
  registrations        Registration[]
  seeds                Seed[]
  matches              Match[]
  announcements        Announcement[]
  prizes               Prize[]
  auditEvents          AuditEvent[]

  @@unique([slug], map: "Tournament_slug_active_key", where: { deletedAt: null })
  @@index([status, gameId, region, tournamentStartAt])
  @@index([organizationId, status])
}

model TournamentModerator {
  id               String     @id @default(uuid()) @db.Uuid
  tournamentId     String     @db.Uuid
  userId           String     @db.Uuid
  assignedByUserId String     @db.Uuid
  expiresAt        DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  tournament       Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user             User       @relation("TournamentModeratorUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy       User       @relation("TournamentModeratorAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, userId])
  @@index([userId, expiresAt])
}

model TournamentStage {
  id            String              @id @default(uuid()) @db.Uuid
  tournamentId  String              @db.Uuid
  name          String
  type          TournamentStageType
  position      Int
  configuration Json                @default("{}") @db.JsonB
  version       Int                 @default(1)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  tournament    Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rounds        Round[]

  @@unique([tournamentId, position])
}

model TournamentRule {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  title        String
  content      String
  position     Int
  revision     Int
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, revision, position])
  @@index([tournamentId, revision])
}

model Registration {
  id                String             @id @default(uuid()) @db.Uuid
  tournamentId      String             @db.Uuid
  teamId            String             @db.Uuid
  submittedByUserId String             @db.Uuid
  reviewedByUserId  String?            @db.Uuid
  status            RegistrationStatus @default(DRAFT)
  revision          Int                @default(1)
  acceptedRuleRevision Int             @default(0)
  eligibilityResult Json?              @db.JsonB
  rejectionReason   String?
  submittedAt       DateTime?          @db.Timestamptz(3)
  reviewedAt        DateTime?          @db.Timestamptz(3)
  withdrawnAt       DateTime?          @db.Timestamptz(3)
  disqualifiedAt    DateTime?          @db.Timestamptz(3)
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  team              Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  submittedBy       User               @relation("RegistrationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?              @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  rosterSnapshot    RosterSnapshot?
  checkIn           CheckIn?
  seed              Seed?
  matchParticipants MatchParticipant[]
  resultSubmissions ResultSubmission[]
  wonMatches        Match[]            @relation("MatchWinner")
  lostMatches       Match[]            @relation("MatchLoser")
  wonGames          MatchGame[]        @relation("MatchGameWinner")

  @@unique([tournamentId, teamId, revision])
  @@index([tournamentId, status, createdAt])
  @@index([teamId, status])
}

model RosterSnapshot {
  id             String                 @id @default(uuid()) @db.Uuid
  registrationId String                 @unique @db.Uuid
  checksum       String                 @unique
  lockedAt       DateTime?              @db.Timestamptz(3)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)
  registration   Registration           @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  members        RosterSnapshotMember[]
}

model RosterSnapshotMember {
  id             String         @id @default(uuid()) @db.Uuid
  snapshotId     String         @db.Uuid
  userId         String         @db.Uuid
  gameAccountId  String         @db.Uuid
  role           TeamMemberRole
  displayName    String
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  snapshot       RosterSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  gameAccount    GameAccount    @relation(fields: [gameAccountId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, userId])
  @@unique([snapshotId, gameAccountId])
}

model CheckIn {
  id                String        @id @default(uuid()) @db.Uuid
  registrationId    String        @unique @db.Uuid
  checkedInByUserId String        @db.Uuid
  status            CheckInStatus @default(CONFIRMED)
  checkedInAt       DateTime      @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime?     @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  registration      Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedInBy       User          @relation("CheckInUser", fields: [checkedInByUserId], references: [id], onDelete: Restrict)
}

model Seed {
  id             String       @id @default(uuid()) @db.Uuid
  tournamentId   String       @db.Uuid
  registrationId String       @unique @db.Uuid
  value          Int
  source         SeedSource
  score          Decimal?     @db.Decimal(12, 4)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, value])
  @@index([tournamentId, source])
}

model Round {
  id          String          @id @default(uuid()) @db.Uuid
  stageId     String          @db.Uuid
  number      Int
  name        String
  status      String          @default("PENDING")
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  stage       TournamentStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches     Match[]

  @@unique([stageId, number])
}

model Match {
  id                String             @id @default(uuid()) @db.Uuid
  tournamentId      String             @db.Uuid
  roundId           String             @db.Uuid
  externalKey       String
  bracketSide       BracketSide
  position          Int
  status            MatchStatus        @default(SCHEDULED)
  scheduledAt       DateTime?          @db.Timestamptz(3)
  startedAt         DateTime?          @db.Timestamptz(3)
  completedAt       DateTime?          @db.Timestamptz(3)
  bestOf            Int                @default(1)
  winnerRegistrationId String?         @db.Uuid
  loserRegistrationId  String?         @db.Uuid
  score              Json               @default("{}") @db.JsonB
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  tournament         Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round              Round              @relation(fields: [roundId], references: [id], onDelete: Cascade)
  winnerRegistration Registration?      @relation("MatchWinner", fields: [winnerRegistrationId], references: [id], onDelete: SetNull)
  loserRegistration  Registration?      @relation("MatchLoser", fields: [loserRegistrationId], references: [id], onDelete: SetNull)
  participants       MatchParticipant[]
  games              MatchGame[]
  resultSubmissions  ResultSubmission[]
  disputes           Dispute[]

  @@unique([tournamentId, externalKey])
  @@unique([tournamentId, roundId, position])
  @@index([tournamentId, status, scheduledAt])
}

model MatchParticipant {
  id             String                  @id @default(uuid()) @db.Uuid
  matchId        String                  @db.Uuid
  registrationId String?                 @db.Uuid
  slot           Int
  source         MatchParticipantSource
  sourceMatchId  String?                 @db.Uuid
  seedValue      Int?
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  match          Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  registration   Registration?           @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@unique([matchId, slot])
  @@index([registrationId])
}

model MatchGame {
  id             String        @id @default(uuid()) @db.Uuid
  matchId        String        @db.Uuid
  number         Int
  status         MatchStatus   @default(SCHEDULED)
  score          Json          @default("{}") @db.JsonB
  winnerRegistrationId String? @db.Uuid
  startedAt      DateTime?     @db.Timestamptz(3)
  completedAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  match          Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winner         Registration? @relation("MatchGameWinner", fields: [winnerRegistrationId], references: [id], onDelete: SetNull)

  @@unique([matchId, number])
}

model ResultSubmission {
  id                String                 @id @default(uuid()) @db.Uuid
  matchId           String                 @db.Uuid
  registrationId    String                 @db.Uuid
  submittedByUserId String                 @db.Uuid
  confirmedByUserId String?                @db.Uuid
  source            ResultSource
  status            ResultSubmissionStatus @default(SUBMITTED)
  score             Json                   @db.JsonB
  clientIdempotencyKey String?
  rejectionReason   String?
  submittedAt       DateTime               @default(now()) @db.Timestamptz(3)
  confirmedAt       DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  match             Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  registration      Registration           @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  submittedBy       User                   @relation("ResultSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  confirmedBy       User?                  @relation("ResultConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  evidence          Evidence[]

  @@unique([matchId, registrationId, clientIdempotencyKey])
  @@index([matchId, status, createdAt])
}

model Evidence {
  id                   String            @id @default(uuid()) @db.Uuid
  resultSubmissionId   String            @db.Uuid
  uploadedByUserId     String            @db.Uuid
  kind                 EvidenceKind
  objectKey            String
  contentType          String
  sizeBytes            BigInt
  sha256               String
  scanStatus           EvidenceScanStatus @default(PENDING)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  resultSubmission     ResultSubmission  @relation(fields: [resultSubmissionId], references: [id], onDelete: Cascade)
  uploadedBy           User              @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([objectKey])
  @@index([resultSubmissionId, scanStatus])
}

model Dispute {
  id                String        @id @default(uuid()) @db.Uuid
  matchId           String        @db.Uuid
  openedByUserId    String        @db.Uuid
  assignedModeratorId String?     @db.Uuid
  resolvedByUserId  String?       @db.Uuid
  status            DisputeStatus @default(OPEN)
  reason            String
  resolution       String?
  openedAt          DateTime      @default(now()) @db.Timestamptz(3)
  resolvedAt        DateTime?     @db.Timestamptz(3)
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  match             Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  openedBy          User          @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedModerator User?         @relation("DisputeModerator", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  resolvedBy        User?         @relation("DisputeResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  messages          DisputeMessage[]

  @@index([matchId, status])
  @@index([assignedModeratorId, status])
}

model DisputeMessage {
  id          String           @id @default(uuid()) @db.Uuid
  disputeId   String           @db.Uuid
  authorUserId String          @db.Uuid
  body        String
  visibility  MessageVisibility @default(PARTICIPANTS)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  dispute     Dispute          @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author      User             @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([disputeId, createdAt])
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  type      String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?            @db.Timestamptz(3)
  payload   Json                 @default("{}") @db.JsonB
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @db.Timestamptz(3)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Announcement {
  id           String      @id @default(uuid()) @db.Uuid
  tournamentId String      @db.Uuid
  authorUserId String      @db.Uuid
  title        String
  body         String
  publishedAt  DateTime?   @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  author       User        @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([tournamentId, publishedAt])
}

model Prize {
  id           String    @id @default(uuid()) @db.Uuid
  tournamentId String    @db.Uuid
  position     Int
  title        String
  kind         PrizeKind
  value        String?
  metadata     Json      @default("{}") @db.JsonB
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, position])
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @db.Uuid
  organizationId String?       @db.Uuid
  tournamentId   String?       @db.Uuid
  action         String
  entityType     String
  entityId       String
  correlationId   String
  before         Json?
  after          Json?
  metadata       Json          @default("{}") @db.JsonB
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tournament    Tournament?   @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([tournamentId, createdAt])
  @@index([actorUserId, createdAt])
}

model IdempotencyRecord {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String?          @db.Uuid
  key            String
  method         String
  route          String
  requestHash    String
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime         @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, method, route])
  @@index([expiresAt, status])
}
