# Local development only. Copy to .env and fill every empty value locally.
# Never commit credentials or generated secrets.
NODE_ENV=development
LOG_LEVEL=debug
WEB_PORT=3000
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL
POSTGRES_USER=arena_grid
POSTGRES_PASSWORD=
POSTGRES_DB=arena_grid
POSTGRES_PORT=5432
DATABASE_URL=

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Authentication
JWT_SECRET=
COOKIE_SECURE=false
